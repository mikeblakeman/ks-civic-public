  "definitions": {
   "Kept": {
    "effort": "Acted and voted consistently every time it came up",
    "outcome": "Adopted or achieved"
   },
   "Partial": {
    "effort": "Mixed record, or acted on a narrower version",
    "outcome": "A compromise version adopted"
   },
   "In progress": {
    "effort": "Not yet up for action, or action underway",
    "outcome": "Underway with a dated next step"
   },
   "Stalled": {
    "effort": "No action in 12+ months despite opportunity",
    "outcome": "No movement in 12+ months"
   },
   "Broken": {
    "effort": "Acted or voted against the commitment",
    "outcome": "Rejected or reversed"
   },
   "Unverifiable": {
    "effort": "No public record could show it either way",
    "outcome": "Same"
   },
   "Pre-office": {
    "effort": "Made as a candidate; nothing to score until they hold the office",
    "outcome": "Same"
   },
   "Moot": {
    "effort": "Candidate lost; kept for the record, never scored",
    "outcome": "Same"
   },
   "Not scored": {
    "effort": "Used only for positions",
    "outcome": "Same"
   }
  }
